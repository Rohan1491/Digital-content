ANTHROPIC_API_KEY=your_anthropic_key_here
PORT=3000
DB_PATH=

# Watermarked generated images are hosted at PUBLIC_BASE_URL + /uploads/<file>
# (needed because Instagram's publish API requires a publicly reachable
# image_url). Leave unset to auto-derive from the incoming request's own
# host — only set this if running behind a reverse proxy that rewrites it.
PUBLIC_BASE_URL=

ADMIN_PASSWORD=

# Instagram — Instagram Login product (graph.instagram.com)
IG_ACCESS_TOKEN=
IG_USER_ID=

# BytePlus ModelArk — image generation (Seedream models)
BYTEPLUS_API_KEY=

# LinkedIn — Sign In with LinkedIn v2 + Posts API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# Google Drive — every generated image is saved here. Create a service
# account in Google Cloud Console, enable the Drive API, download its JSON
# key to the path below (gitignored — never commit it), then share the
# target Drive folder with the key's client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json
GOOGLE_DRIVE_FOLDER_ID=
